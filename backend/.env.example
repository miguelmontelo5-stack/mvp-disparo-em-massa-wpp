# Porta e Host do Fastify API
PORT=3001
HOST=0.0.0.0

# Conexão com Redis (BullMQ, Locks e Cache)
REDIS_URL=redis://localhost:6379

# Conexão com PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/disparo_massa

# Diretório de credenciais das sessões do WhatsApp (Baileys)
AUTH_DIR=./auth_sessions

# Intervalo padrão entre disparos (em milissegundos)
SEND_DELAY_MS=800

# Nível de Log (info, warn, error, debug)
LOG_LEVEL=info

# Supabase Auth & Database (Obrigatório para autenticação de produção)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS (Domínio do Frontend no Cloudflare Pages, ex: https://dlm.pages.dev ou *)
CORS_ORIGIN=*
